# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env

# App
APP_NAME=Siftwell API
APP_ENV=development
DEBUG=true

# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/siftwell

# Comma-separated list of frontend URLs allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Google Gemini API (https://aistudio.google.com/apikey). Keep the key secret:
# it is only used by the backend and is never sent to the browser.
GEMINI_API_KEY=
# A fast Flash model available on the free tier
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds for one Gemini call, and for the whole extraction (including any retry).
# After that, Siftwell falls back to basic text matching.
GEMINI_TIMEOUT_SECONDS=10
GEMINI_TOTAL_TIMEOUT_SECONDS=15
# Gemini 3 thinking level: minimal | low | medium | high (empty = model default)
GEMINI_THINKING_LEVEL=minimal
# Max output tokens (thinking tokens count toward this)
GEMINI_MAX_OUTPUT_TOKENS=800
